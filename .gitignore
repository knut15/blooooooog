# ── 비밀 ──────────────────────────────────────────────
# DB 비밀번호와 관리자 비밀번호가 들어 있다. 절대 커밋하지 않는다.
.env
.env.*
!.env.example

# ── WordPress 코어 ────────────────────────────────────
# 코어는 setup-local.sh 가 다시 내려받는다. 추적하지 않는다.
# 단, 우리가 쓴 자식 테마만 단계적으로 열어 준다.
/wordpress/*
!/wordpress/wp-content/
/wordpress/wp-content/*
!/wordpress/wp-content/themes/
/wordpress/wp-content/themes/*
!/wordpress/wp-content/themes/generatepress-child/

# 업로드·캐시·로그는 환경마다 다르다
/wordpress/wp-content/uploads/
/wordpress/wp-content/upgrade/
/wordpress/wp-content/cache/
/wordpress/wp-content/debug.log

# ── 로컬 도구·산출물 ──────────────────────────────────
/bin/wp.phar
/backups/
.omc/
node_modules/
*.log

# curvez 실행 부산물 — 재현 가치가 없다
.curvez/tmp/

# ── macOS ─────────────────────────────────────────────
.DS_Store
